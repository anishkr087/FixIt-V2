{
  "expo": {
    "name": "fixit_patner",
    "slug": "fixit_patner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FixIt Partner uses your background location to receive nearby customer service requests even when the app is minimized.",
        "NSLocationWhenInUseUsageDescription": "FixIt Partner requires location access to find customer service jobs in your area."
      }
    },
    "android": {
      "package": "com.kumar.fixitpartner",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForGoogleMapsInitializationToPreventCrash"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
